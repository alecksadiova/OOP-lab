package com.mycompany.activity1;

import java.util.Scanner;

public class Activity1 {
  public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.println("Please provide the following:");

        System.out.print("Brand: ");
        String brand = input.nextLine();
        
        System.out.print("Model: ");
        String model = input.nextLine();

        System.out.print("Plate: ");
        String plateNum = input.nextLine();

        System.out.print("Year: ");
        int year = input.nextInt();
        
        System.out.print("Engine: ");
        double engine = input.nextDouble();

        System.out.println("Vehicles");
        System.out.println("Brand: " + brand);
        System.out.println("Model: " + model);
        System.out.println("Plate Number" + plateNum);
        System.out.println("Year " + year);
        System.out.println("Engine: " + engine + " L");

        input.close();
    }
}
